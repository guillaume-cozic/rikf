---

---

<section id="inscription" class="relative py-24 sm:py-32 overflow-hidden">
  <!-- Bandeau lagon en fond -->
  <div class="absolute inset-0 bg-lagoon-wave opacity-90"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-white/0 via-white/10 to-white/40"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/90 backdrop-blur border border-white text-deep-900 font-semibold text-xs uppercase tracking-widest mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-coral-500"></span>
        Inscription
      </div>
      <h2 class="font-display text-5xl sm:text-6xl md:text-7xl uppercase leading-tight text-white drop-shadow-lg">
        Ride <span class="text-deep-900">the</span> Wind
      </h2>
      <p class="mt-6 text-lg text-white/95 drop-shadow">
        Inscriptions ouvertes pour tous les niveaux. Pour participer aux compétitions,
        contactez directement Mourouk Wind Sports.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5">
      <a
        href="mailto:mouroukwindsports@gmail.com?subject=Inscription%20RIKF%202026"
        class="group relative p-8 rounded-3xl bg-white hover:scale-[1.02] transition-all shadow-2xl border border-white/60 overflow-hidden"
      >
        <div class="absolute -top-6 -right-6 w-32 h-32 bg-lagoon-100/80 rounded-full blur-2xl"></div>
        <div class="relative">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-lagoon-400 to-lagoon-600 flex items-center justify-center mb-5 shadow-md">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="text-xs uppercase tracking-widest text-lagoon-600 font-semibold">Par email</div>
          <div class="mt-1 font-display text-2xl sm:text-3xl uppercase text-deep-900 break-all">
            mouroukwindsports
            <span class="block">@gmail.com</span>
          </div>
          <div class="mt-5 inline-flex items-center gap-2 text-lagoon-600 font-semibold">
            Envoyer un message
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
        </div>
      </a>

      <a
        href="tel:+23059073807"
        class="group relative p-8 rounded-3xl bg-deep-900 text-white hover:bg-deep-800 transition-all shadow-2xl border border-deep-700"
      >
        <div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center mb-5 shadow-md">
          <svg class="w-7 h-7 text-lagoon-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <div class="text-xs uppercase tracking-widest text-lagoon-300 font-semibold">Par téléphone</div>
        <div class="mt-1 font-display text-3xl sm:text-4xl">+230 59073807</div>
        <div class="mt-2 text-sm text-white/60">Whatsapp & appels — Île Maurice (UTC+4)</div>
        <div class="mt-5 inline-flex items-center gap-2 text-lagoon-300 font-semibold">
          Appeler
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </div>
      </a>
    </div>

  </div>
</section>
