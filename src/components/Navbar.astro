---
const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}#about`, label: "Le festival" },
  { href: `${base}#competitions`, label: "Compétitions" },
  { href: `${base}#programme`, label: "Programme" },
  { href: `${base}#rodrigues`, label: "Rodrigues" },
  { href: `${base}association`, label: "Association" },
  { href: `${base}#inscription`, label: "Inscription" },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-white/80 border-b border-lagoon-100"
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a href={base} class="flex items-center gap-3 group" aria-label="RIKF 2026 — Accueil">
      <img
        src={`${base}logo-rikf.png`}
        alt="RIKF 2026 — Ride the Wind"
        class="h-12 w-auto transition-transform group-hover:scale-105"
        width="48"
        height="48"
      />
      <div class="leading-tight hidden sm:block">
        <div class="font-display text-base tracking-wider text-deep-900 uppercase">Rodrigues International</div>
        <div class="text-[10px] uppercase tracking-[0.2em] text-deep-900/60">Kite Surf Festival</div>
      </div>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-sm font-medium text-deep-900/80 hover:text-deep-900 transition-colors relative after:absolute after:bottom-[-6px] after:left-0 after:right-0 after:h-[2px] after:bg-lagoon-500 after:scale-x-0 hover:after:scale-x-100 after:transition-transform after:origin-left"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <a
      href={`${base}#inscription`}
      class="hidden md:inline-flex items-center gap-2 px-4 py-2 rounded-full bg-lagoon-500 hover:bg-lagoon-600 text-white font-semibold text-sm transition-all hover:scale-105 shadow-lg shadow-lagoon-400/40"
    >
      S'inscrire
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>

    <button id="mobile-menu-toggle" class="md:hidden p-2 text-deep-900" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-lagoon-100 bg-white/95 backdrop-blur-md">
    <div class="px-4 py-4 space-y-3">
      {
        links.map((l) => (
          <a href={l.href} class="block py-2 text-deep-900/80 hover:text-lagoon-500">
            {l.label}
          </a>
        ))
      }
      <a
        href={`${base}#inscription`}
        class="block text-center py-3 mt-2 rounded-full bg-lagoon-500 text-white font-semibold"
      >
        S'inscrire
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => menu?.classList.toggle("hidden"));
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => menu.classList.add("hidden")),
  );
</script>
