---
const base = import.meta.env.BASE_URL;
---

<footer class="relative bg-deep-900 text-white border-t border-lagoon-700 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-4 gap-10">
      <div class="md:col-span-2">
        <div class="flex items-center gap-4">
          <div class="bg-white p-1.5 rounded-xl">
            <img
              src={`${base}logo-rikf.png`}
              alt="RIKF 2026 — Ride the Wind"
              class="h-14 w-auto"
            />
          </div>
          <div>
            <div class="font-display text-xl tracking-wider uppercase">Rodrigues International</div>
            <div class="text-xs uppercase tracking-[0.2em] text-white/60">Kite Surf Festival 2026</div>
          </div>
        </div>
        <p class="mt-5 text-sm text-white/70 leading-relaxed max-w-md">
          Rodrigues International Kite Surf Festival — 11<sup>e</sup> édition.
          Du 2 au 5 juillet 2026, lagon de Mourouk, Île Rodrigues.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 text-xs uppercase tracking-widest text-white/50">
          <span>Co-organisateurs</span>
          <span class="text-white">·</span>
          <span class="text-white/80">Office du Tourisme de Rodrigues</span>
          <span class="text-white">·</span>
          <span class="text-white/80">Mourouk Wind Sports</span>
        </div>
      </div>

      <div>
        <div class="text-xs uppercase tracking-widest text-lagoon-300 mb-4">Navigation</div>
        <ul class="space-y-2 text-sm text-white/80">
          <li><a href={`${base}#about`} class="hover:text-lagoon-300 transition-colors">Le festival</a></li>
          <li><a href={`${base}#competitions`} class="hover:text-lagoon-300 transition-colors">Compétitions</a></li>
          <li><a href={`${base}#programme`} class="hover:text-lagoon-300 transition-colors">Programme</a></li>
          <li><a href={`${base}#rodrigues`} class="hover:text-lagoon-300 transition-colors">Rodrigues</a></li>
          <li><a href={`${base}association`} class="hover:text-lagoon-300 transition-colors">Association</a></li>
          <li><a href={`${base}#inscription`} class="hover:text-lagoon-300 transition-colors">Inscription</a></li>
        </ul>
      </div>

      <div>
        <div class="text-xs uppercase tracking-widest text-lagoon-300 mb-4">Contact</div>
        <ul class="space-y-3 text-sm text-white/80">
          <li>
            <a href="mailto:mouroukwindsports@gmail.com" class="flex items-start gap-2 hover:text-lagoon-300 transition-colors">
              <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="break-all">mouroukwindsports@gmail.com</span>
            </a>
          </li>
          <li>
            <a href="tel:+23059073807" class="flex items-center gap-2 hover:text-lagoon-300 transition-colors">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              +230 59073807
            </a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Mourouk, Rodrigues
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-white/50">
      <div>© 2026 Rodrigues International Kite Surf Festival. Tous droits réservés.</div>
      <div class="flex items-center gap-2">
        <span>#RideTheWind</span>
        <span class="w-1 h-1 rounded-full bg-white/30"></span>
        <span>#RIKF2026</span>
        <span class="w-1 h-1 rounded-full bg-white/30"></span>
        <span>#Rodrigues</span>
      </div>
    </div>
  </div>
</footer>
