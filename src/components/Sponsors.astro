---
const base = import.meta.env.BASE_URL;
const sponsors = [
  {
    name: "Région Autonome de Rodrigues",
    src: `${base}sponsor-rodrigues.png`,
    alt: "Armoiries de la Région Autonome de Rodrigues",
  },
  {
    name: "Rodrigues Tourism Office",
    src: `${base}sponsor-tourism.png`,
    alt: "Logo Rodrigues Tourism Office",
  },
];
---

<section class="relative bg-white border-t border-lagoon-100 py-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <div class="chip-light mx-auto mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-lagoon-500"></span>
        Avec le soutien de
      </div>
      <h2 class="font-display text-3xl sm:text-4xl uppercase text-deep-900 tracking-wide">
        Nos partenaires officiels
      </h2>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-10 sm:gap-16">
      {
        sponsors.map((s) => (
          <div class="group flex flex-col items-center text-center">
            <div class="bg-white rounded-2xl p-4 transition-all hover:scale-105">
              <img
                src={s.src}
                alt={s.alt}
                class="h-24 sm:h-28 w-auto object-contain"
                loading="lazy"
              />
            </div>
            <div class="mt-3 text-xs uppercase tracking-widest text-deep-900/60">
              {s.name}
            </div>
          </div>
        ))
      }
    </div>

    <!-- CTA Devenir sponsor -->
    <div class="mt-16 relative overflow-hidden rounded-3xl bg-gradient-to-br from-lagoon-500 to-lagoon-700 p-8 sm:p-10">
      <div class="absolute -top-10 -right-10 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-10 -left-10 w-64 h-64 bg-sun-400/20 rounded-full blur-3xl"></div>

      <div class="relative grid sm:grid-cols-[1fr_auto] gap-6 items-center">
        <div class="text-white">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 backdrop-blur border border-white/30 text-xs uppercase tracking-widest font-semibold mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-sun-400"></span>
            Sponsoring
          </div>
          <h3 class="font-display text-3xl sm:text-4xl uppercase tracking-wide leading-tight">
            Associez votre marque <span class="text-sun-400">au RIKF</span>
          </h3>
          <p class="mt-3 text-white/90 max-w-2xl">
            Visibilité internationale, retombées presse, événement reconnu dans
            l'océan Indien. Plusieurs formules de partenariat disponibles.
          </p>
        </div>
        <a
          href="mailto:mouroukwindsports@gmail.com?subject=Devenir%20sponsor%20RIKF%202026"
          class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-white hover:bg-sun-400 text-deep-900 font-semibold whitespace-nowrap transition-all hover:scale-105 shadow-xl"
        >
          Devenir sponsor
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
